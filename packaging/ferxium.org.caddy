# Import this file from /etc/caddy/Caddyfile, after reviewing the main configuration.
# Releases are immutable; publishing atomically switches the current symlink.
ferxium.org {
    root * /var/www/ferxium.org/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    @assets path /_astro/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @downloads path /downloads/*
    header @downloads Cache-Control "public, max-age=300"
    file_server
    handle_errors {
        @notfound expression {err.status_code} == 404
        handle @notfound {
            rewrite * /404.html
            file_server
        }
    }
}

www.ferxium.org {
    redir https://ferxium.org{uri} permanent
}
