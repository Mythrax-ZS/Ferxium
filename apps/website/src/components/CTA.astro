---
import Icon from './Icon.astro';
---

<section class="cta-section container">
  <div class="cta-glow"></div>
  <span class="eyebrow cyan">YOUR NEXT CHAPTER. A LITTLE MORE PROTECTED.</span>
  <h2>
    Peace of mind.
    <br />
    Without the price tag.
  </h2>
  <p>Unbreakable Protection. Zero Cost. Built in Rust.</p>
  <div class="cta-buttons">
    <a class="button primary" href="/download/#windows">
      <Icon name="windows" size={17} />
      Download for Windows
      <Icon name="arrow" size={16} />
    </a>
    <a class="button secondary" href="/download/#macos">
      macOS
    </a>
    <a class="button secondary" href="/download/#linux">
      Linux
    </a>
  </div>
  <small>100% free forever · Open source · No account required</small>
</section>
