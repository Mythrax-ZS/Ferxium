{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main window may control the current-user protection service.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-service-status",
    "allow-service-action",
    "allow-desktop-preferences",
    "allow-set-desktop-preference",
    "allow-test-notification"
  ]
}
